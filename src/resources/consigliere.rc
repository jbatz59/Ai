#include <winver.h>
#include "cg_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CG_VERSION_MAJOR, CG_VERSION_MINOR, CG_VERSION_PATCH, 0
PRODUCTVERSION CG_VERSION_MAJOR, CG_VERSION_MINOR, CG_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Consigliere contributors"
      VALUE "FileDescription", "Consigliere - single-player mod menu and RE toolkit for Mafia: Definitive Edition"
      VALUE "FileVersion", CG_VERSION
      VALUE "InternalName", "Consigliere"
      VALUE "OriginalFilename", "Consigliere.dll"
      VALUE "ProductName", "Consigliere"
      VALUE "ProductVersion", CG_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
